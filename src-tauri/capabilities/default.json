{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: the application's own commands, plus the three core permissions the question about unsaved changes on closing needs (listen to the close request, stop listening, destroy the window).",
  "windows": ["main"],
  "permissions": [
    "allow-tree",
    "allow-get-node",
    "allow-save-node-content",
    "allow-import-files",
    "allow-import-globals",
    "allow-environments",
    "allow-active-environment",
    "allow-set-active-environment",
    "allow-send-request",
    "allow-cancel-send",
    "allow-response-body",
    "allow-release-body",
    "allow-format-json",
    "allow-create-node",
    "allow-rename-node",
    "allow-duplicate-node",
    "allow-delete-node",
    "allow-get-environment",
    "allow-save-environment",
    "allow-create-environment",
    "allow-delete-environment",
    "allow-export-collection",
    "allow-export-environment",
    "allow-history-list",
    "allow-history-get",
    "allow-history-clear",
    "allow-copy-response-body",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy"
  ]
}
