{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only the application's own commands, no core plugins.",
  "windows": ["main"],
  "permissions": [
    "allow-tree",
    "allow-get-node",
    "allow-save-node-content",
    "allow-import-files",
    "allow-import-globals",
    "allow-environments",
    "allow-active-environment",
    "allow-set-active-environment",
    "allow-send-request",
    "allow-cancel-send",
    "allow-response-body",
    "allow-release-body"
  ]
}
