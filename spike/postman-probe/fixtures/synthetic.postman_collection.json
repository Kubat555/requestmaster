{
  "info": {
    "_postman_id": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee",
    "name": "Синтетическая коллекция",
    "description": "Выдуманный образец для пробника",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "0000000",
    "x-unknown": { "nested": [1, 2.5, null, true] }
  },
  "item": [
    {
      "name": "Авторизация",
      "description": "Папка первого уровня",
      "auth": {
        "type": "basic",
        "basic": [
          { "key": "username", "value": "user", "type": "string" },
          { "key": "password", "value": "pass", "type": "string" }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": "const _ = require('lodash'); console.log(_.VERSION);"
          }
        }
      ],
      "item": [
        {
          "name": "Получить токен",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "s-1",
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.environment.set('token', json.token);",
                  "pm.test('status ok', function () { pm.response.to.have.status(200); });"
                ],
                "x-unknown": "script-level"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Off", "value": "1", "disabled": true, "description": "отключён" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"логин\": \"тест\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token?grant=password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "token"],
              "query": [{ "key": "grant", "value": "password" }],
              "x-unknown": "url-level"
            },
            "x-unknown": "request-level"
          },
          "response": [
            {
              "name": "Успешный ответ",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "url": { "raw": "{{baseUrl}}/auth/token", "host": ["{{baseUrl}}"], "path": ["auth", "token"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\"token\": \"fake\"}"
            }
          ],
          "protocolProfileBehavior": { "disableBodyPruning": true }
        },
        {
          "name": "Вложенная папка",
          "item": [
            {
              "name": "Загрузка файла",
              "auth": { "type": "noauth" },
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "title", "value": "Заголовок", "type": "text" },
                    { "key": "file", "type": "file", "src": "/tmp/example.bin" }
                  ]
                },
                "url": "https://example.com/upload"
              }
            },
            {
              "name": "Форма",
              "auth": { "type": "x-future", "x-future": [{ "key": "k", "value": "v" }] },
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    { "key": "имя", "value": "значение" },
                    { "key": "off", "value": "x", "disabled": true }
                  ]
                },
                "url": { "raw": "https://example.com/form", "protocol": "https", "host": ["example", "com"], "path": ["form"] }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Проверка связи",
      "request": "https://example.com/ping"
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://example.com", "type": "string" }
  ],
  "protocolProfileBehavior": { "followRedirects": false }
}
